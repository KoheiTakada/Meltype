<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        学習データ、絵文字の「最近使ったもの」、設定を、別の端末やクラウドに写さない（spec 09）。
        allowBackup="false" だけでは、Android 12 以降の端末から端末への引き継ぎが止まらないので、
        すべてのデータを外す規則も付ける（Android 12 以降は dataExtractionRules、それより前は fullBackupContent）。
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- クリップボードの履歴の期限切れを、キーボードを開かない日も消す (ClipboardCleanupJob)。再起動のあとも続ける。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 履歴のリンクのプレビュー (OGP) と、翻訳のモデル (ML Kit) を取ってくる。コピーした文字そのものは送らない。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 最近のスクリーンショットを候補に出す。設定で利用者が許可したときだけ読む (RecentScreenshotSource)。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LicensesActivity"
            android:exported="false" />
        <activity
            android:name=".clipboard.ClipboardEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- 履歴の画像・ファイルを、受け取れる入力欄に貼り付けるときだけ、読み取りの権限を渡す。 -->
        <provider
            android:name=".clipboard.ClipboardContentProvider"
            android:authorities="${applicationId}.clipboard"
            android:exported="false"
            android:grantUriPermissions="true" />
        <service
            android:name=".clipboard.ClipboardCleanupJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
        <!-- BIND_INPUT_METHOD は、このサービスをシステムだけが呼べるようにする属性。権限の要求ではない。 -->
        <service
            android:name=".KeyboardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
